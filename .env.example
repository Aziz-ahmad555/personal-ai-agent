# Copy to .env and fill in real values. Never commit .env.

# --- App ---
APP_ENV=development
APP_SECRET_KEY=change-me-to-a-random-64-char-hex-string

# --- Database ---
POSTGRES_USER=agent
POSTGRES_PASSWORD=change-me
POSTGRES_DB=personal_agent
# 5433, not 5432 — avoids colliding with a native/standalone Postgres already on the machine.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
DATABASE_URL=postgresql+asyncpg://agent:change-me@localhost:5433/personal_agent

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Auth / JWT ---
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- CORS ---
CORS_ORIGINS=http://localhost:5173

# --- Embeddings (Voyage AI) ---
# Get a key at https://dash.voyageai.com. Profile embeddings are skipped (with a
# logged warning) if this is unset — profile CRUD still works without it.
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3-lite
