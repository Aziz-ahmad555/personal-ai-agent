# Copy to .env and fill in real values. Never commit .env.

# --- App ---
APP_ENV=development
APP_SECRET_KEY=change-me-to-a-random-64-char-hex-string

# --- Database ---
POSTGRES_USER=agent
POSTGRES_PASSWORD=change-me
POSTGRES_DB=personal_agent
# 5433, not 5432 — avoids colliding with a native/standalone Postgres already on the machine.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
DATABASE_URL=postgresql+asyncpg://agent:change-me@localhost:5433/personal_agent

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Auth / JWT ---
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- CORS ---
CORS_ORIGINS=http://localhost:5173

# --- Embeddings (Voyage AI) ---
# Get a key at https://dash.voyageai.com. Profile embeddings are skipped (with a
# logged warning) if this is unset — profile CRUD still works without it.
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3-lite

# --- Search (Tavily) ---
# Get a key at https://tavily.com. Required for the Research Engine's search step —
# unlike embeddings, a research query cannot run at all without it, and fails clearly
# (not silently) if this is unset.
TAVILY_API_KEY=

# --- LLM (claim extraction / report drafting) ---
# Powers the Research Engine's two LLM-assisted steps — both always constrained to cite
# verbatim source text, never asserted from the model's own knowledge. Swappable behind
# app.research.llm.LLMProvider; LLM_PROVIDER selects which one is active ("gemini" | "anthropic").
LLM_PROVIDER=gemini

# Get a free-tier key at https://aistudio.google.com/apikey.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Get a key at https://console.anthropic.com. Only needed if LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Gmail (read-only) ---
# Create OAuth credentials at https://console.cloud.google.com (OAuth consent screen kept
# in "Testing" status with yourself as a test user — no Google review needed for personal
# use, but refresh tokens then expire after 7 days; reconnect via the Gmail page when that
# happens). Request only the gmail.readonly scope.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match a redirect URI registered on the OAuth client above.
GOOGLE_REDIRECT_URI=http://localhost:8000/gmail/oauth/callback
GMAIL_FRONTEND_RETURN_URL=http://localhost:5173/gmail
# Encrypts stored OAuth tokens at rest (Fernet) — these are live credentials to a real
# inbox. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
# How far back the initial sync backfills (data-minimization default; nothing has judged
# relevance yet at this read-only stage, so this stays bounded rather than pulling everything).
GMAIL_SYNC_WINDOW_DAYS=180

# --- Career Intelligence: job discovery ---
# Greenhouse, Lever, and Ashby need no key — their job-board APIs are public and
# unauthenticated. USAJobs is the one board here that requires a free registered key:
# request one at https://developer.usajobs.gov. Its API also requires the requester's own
# contact email as User-Agent, per their terms.
USAJOBS_API_KEY=
USAJOBS_USER_AGENT_EMAIL=
