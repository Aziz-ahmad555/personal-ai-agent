VITE_API_URL=http://localhost:8000

# Set to "true" only in the public demo's own build — never the personal deployment's. Must
# match the backend's demo_mode setting for that same deployment (see backend/.env.example).
# Swaps the login page for a one-click demo sign-in and disables real-connection buttons in
# the UI; the backend enforces the same boundary server-side regardless of this flag.
VITE_DEMO_MODE=false
